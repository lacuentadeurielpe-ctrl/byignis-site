+import { PRECIO_HOTMART } from '@/lib/pago'
+
+/**
+ * País del visitante (lo da Vercel en x-vercel-ip-country) y tipo de cambio desde la moneda base de
+ * Hotmart a la moneda del visitante. Lo usa <PrecioLocal>; el cobro real lo hace Hotmart.
+ */
+export const dynamic = 'force-dynamic'
+
+const MONEDA_POR_PAIS: Record<string, string> = {
+  PE: 'PEN', MX: 'MXN', CL: 'CLP', CO: 'COP', AR: 'ARS', BO: 'BOB', EC: 'USD', US: 'USD', ES: 'EUR',
+  GT: 'GTQ', CR: 'CRC', PA: 'USD', DO: 'DOP', UY: 'UYU', PY: 'PYG', SV: 'USD', HN: 'HNL', NI: 'NIO',
+  VE: 'USD', BR: 'BRL', PR: 'USD', CA: 'CAD',
+}
+
+async function tasa(desde: string, hacia: string): Promise<number | null> {
+  if (desde === hacia) return 1
+  try {
+    const r = await fetch(`https://open.er-api.com/v6/latest/${desde}`, { next: { revalidate: 6 * 3600 } })
+    if (!r.ok) return null
+    const d = (await r.json()) as { result?: string; rates?: Record<string, number> }
+    const t = d.result === 'success' ? d.rates?.[hacia] : undefined
+    return typeof t === 'number' && t > 0 ? t : null
+  } catch {
+    return null
+  }
+}
+
+export async function GET(request: Request) {
+  // ?pais=MX permite probar cómo se ve la página desde otro país
+  const prueba = new URL(request.url).searchParams.get('pais')
+  const pais = (prueba || request.headers.get('x-vercel-ip-country') || '').toUpperCase()
+  // País desconocido: precio base de Hotmart. País fuera de la lista: dólares.
+  const moneda = pais ? (MONEDA_POR_PAIS[pais] ?? 'USD') : PRECIO_HOTMART.moneda
+  const t = await tasa(PRECIO_HOTMART.moneda, moneda)
+  const cuerpo = t ? { pais, moneda, tasa: t } : { pais, moneda: PRECIO_HOTMART.moneda, tasa: 1 }
+  return Response.json(cuerpo, { headers: { 'Cache-Control': 'private, max-age=3600' } })
+}
