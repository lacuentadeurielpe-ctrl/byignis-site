 export const HOTMART_URL = (process.env.NEXT_PUBLIC_HOTMART_CHECKOUT_URL ?? '').trim()
 export const usaHotmart = /^https:\/\/(pay|go)\.hotmart\.com\//.test(HOTMART_URL)
 
+/** Precio base del producto en Hotmart (debe coincidir con "Fijación de precios" en Hotmart). */
+export const PRECIO_HOTMART = { monto: 197, moneda: 'MXN' }
+
 /** Enlace a Hotmart con la landing de origen en `sck` (Hotmart lo muestra en el reporte de ventas). */
 export function enlaceHotmart(segmento: string) {
   const url = new URL(HOTMART_URL)
