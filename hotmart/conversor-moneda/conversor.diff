diff --git a/src/components/PrecioLocal.tsx b/src/components/PrecioLocal.tsx
new file mode 100644
index 0000000..63af929
--- /dev/null
+++ b/src/components/PrecioLocal.tsx
@@ -0,0 +1,68 @@
+'use client'
+
+import { useEffect, useState } from 'react'
+import { PRECIO_HOTMART } from '@/lib/pago'
+
+/**
+ * Precio del producto en la moneda del visitante. En la moneda base de Hotmart (MXN) se muestra exacto;
+ * en otras monedas, aproximado al tipo de cambio del día (Hotmart hace la conversión real al cobrar).
+ */
+type Info = { pais: string; moneda: string; tasa: number }
+
+let pedido: Promise<Info | null> | null = null
+function obtenerInfo() {
+  const prueba = new URLSearchParams(window.location.search).get('pais')
+  pedido ??= fetch(prueba ? `/api/moneda?pais=${encodeURIComponent(prueba)}` : '/api/moneda')
+    .then((r) => (r.ok ? (r.json() as Promise<Info>) : null))
+    .catch(() => null)
+  return pedido
+}
+
+const SIN_DECIMALES = new Set(['CLP', 'COP', 'ARS', 'PYG', 'CRC', 'MXN', 'DOP', 'UYU', 'HNL', 'NIO', 'GTQ', 'BOB', 'PEN'])
+
+function formatear(monto: number, moneda: string, pais: string) {
+  const decimales = SIN_DECIMALES.has(moneda) ? 0 : 2
+  try {
+    const locale = moneda === 'USD' ? 'en-US' : `es-${pais || 'MX'}`
+    const txt = new Intl.NumberFormat(locale, {
+      style: 'currency',
+      currency: moneda,
+      currencyDisplay: 'narrowSymbol',
+      minimumFractionDigits: decimales,
+      maximumFractionDigits: decimales,
+    }).format(monto)
+    return moneda === 'EUR' || moneda === 'PEN' ? txt : `${txt} ${moneda}`
+  } catch {
+    return `${monto.toFixed(decimales)} ${moneda}`
+  }
+}
+
+const BASE = formatear(PRECIO_HOTMART.monto, PRECIO_HOTMART.moneda, 'MX')
+
+function useInfo() {
+  const [info, setInfo] = useState<Info | null>(null)
+  useEffect(() => {
+    let vivo = true
+    obtenerInfo().then((i) => vivo && setInfo(i))
+    return () => {
+      vivo = false
+    }
+  }, [])
+  return info
+}
+
+function textoPrecio(info: Info | null) {
+  if (!info || info.moneda === PRECIO_HOTMART.moneda) return BASE
+  return `≈ ${formatear(PRECIO_HOTMART.monto * info.tasa, info.moneda, info.pais)}`
+}
+
+export function PrecioLocal() {
+  return <>{textoPrecio(useInfo())}</>
+}
+
+/** Nota bajo el precio: aclara que fuera de México el monto es aproximado. */
+export function NotaPrecio() {
+  const info = useInfo()
+  if (!info || info.moneda === PRECIO_HOTMART.moneda) return <>Un solo pago, sin suscripciones.</>
+  return <>Precio aproximado en tu moneda. Un solo pago de {BASE}: Hotmart te cobra el equivalente al tipo de cambio del día.</>
+}
