+/**
+ * País del visitante (lo da Vercel en x-vercel-ip-country) y tipo de cambio desde soles a su moneda.
+ * Lo usa <PrecioLocal> para mostrar el precio aproximado en la moneda local; el cobro real lo hace Hotmart.
+ */
+export const dynamic = 'force-dynamic'
+
+const MONEDA_POR_PAIS: Record<string, string> = {
+  PE: 'PEN', MX: 'MXN', CL: 'CLP', CO: 'COP', AR: 'ARS', BO: 'BOB', EC: 'USD', US: 'USD', ES: 'EUR',
+  GT: 'GTQ', CR: 'CRC', PA: 'USD', DO: 'DOP', UY: 'UYU', PY: 'PYG', SV: 'USD', HN: 'HNL', NI: 'NIO',
+  VE: 'USD', BR: 'BRL', PR: 'USD', CA: 'CAD',
+}
+
+async function tasaDesdeSoles(moneda: string): Promise<number | null> {
+  try {
+    const r = await fetch('https://open.er-api.com/v6/latest/PEN', { next: { revalidate: 6 * 3600 } })
+    if (!r.ok) return null
+    const d = (await r.json()) as { result?: string; rates?: Record<string, number> }
+    const tasa = d.result === 'success' ? d.rates?.[moneda] : undefined
+    return typeof tasa === 'number' && tasa > 0 ? tasa : null
+  } catch {
+    return null
+  }
+}
+
+export async function GET(request: Request) {
+  // ?pais=MX permite probar cómo se ve la página desde otro país
+  const prueba = new URL(request.url).searchParams.get('pais')
+  const pais = (prueba || request.headers.get('x-vercel-ip-country') || '').toUpperCase()
+  const moneda = MONEDA_POR_PAIS[pais]
+  const tasa = moneda && moneda !== 'PEN' ? await tasaDesdeSoles(moneda) : null
+  const cuerpo = tasa ? { pais, moneda, tasa } : { pais, moneda: 'PEN', tasa: 1 }
+  return Response.json(cuerpo, { headers: { 'Cache-Control': 'private, max-age=3600' } })
+}
