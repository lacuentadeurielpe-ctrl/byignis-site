diff --git a/src/components/PrecioLocal.tsx b/src/components/PrecioLocal.tsx
new file mode 100644
index 0000000..abe272e
--- /dev/null
+++ b/src/components/PrecioLocal.tsx
@@ -0,0 +1,63 @@
+'use client'
+
+import { useEffect, useState } from 'react'
+
+/**
+ * Precio en la moneda del visitante (aproximado, al tipo de cambio del día). En Perú, o si no se puede
+ * detectar el país o la tasa, se muestra el precio en soles tal cual.
+ */
+type Info = { pais: string; moneda: string; tasa: number }
+
+let pedido: Promise<Info | null> | null = null
+function obtenerInfo() {
+  const prueba = new URLSearchParams(window.location.search).get('pais')
+  pedido ??= fetch(prueba ? `/api/moneda?pais=${encodeURIComponent(prueba)}` : '/api/moneda')
+    .then((r) => (r.ok ? (r.json() as Promise<Info>) : null))
+    .catch(() => null)
+  return pedido
+}
+
+const soles = (n: number) => `S/ ${n.toFixed(2).replace(/\.00$/, '')}`
+
+function formatear(pen: number, info: Info) {
+  const decimales = info.moneda === 'USD' || info.moneda === 'EUR' || info.moneda === 'CAD' ? 2 : 0
+  const valor = pen * info.tasa
+  try {
+    const txt = new Intl.NumberFormat(`es-${info.pais}`, {
+      style: 'currency',
+      currency: info.moneda,
+      currencyDisplay: 'narrowSymbol',
+      minimumFractionDigits: decimales,
+      maximumFractionDigits: decimales,
+    }).format(valor)
+    return info.moneda === 'EUR' ? `≈ ${txt}` : `≈ ${txt} ${info.moneda}`
+  } catch {
+    return null
+  }
+}
+
+function usePrecioLocal(pen: number) {
+  const [local, setLocal] = useState<string | null>(null)
+  useEffect(() => {
+    let vivo = true
+    obtenerInfo().then((info) => {
+      if (vivo && info && info.moneda !== 'PEN') setLocal(formatear(pen, info))
+    })
+    return () => {
+      vivo = false
+    }
+  }, [pen])
+  return local
+}
+
+export function PrecioLocal({ pen }: { pen: number }) {
+  const local = usePrecioLocal(pen)
+  return <>{local ?? soles(pen)}</>
+}
+
+/** Nota bajo el precio: en Perú muestra `children`; fuera, aclara el equivalente en soles. */
+export function NotaPrecio({ pen, children }: { pen: number; children: React.ReactNode }) {
+  const local = usePrecioLocal(pen)
+  if (!local) return <>{children}</>
+  return <>Equivale a {soles(pen)}. Un solo pago, sin suscripciones: Hotmart te cobra en tu moneda al tipo de cambio del día.</>
+}
